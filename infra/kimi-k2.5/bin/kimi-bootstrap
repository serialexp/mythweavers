#!/usr/bin/env python3

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path


def log(message: str) -> None:
    print(f"[{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}] {message}", flush=True)


def load_manifest(path: Path) -> dict:
    with path.open("r", encoding="utf-8") as handle:
        manifest = json.load(handle)
    if manifest.get("schemaVersion") != 1:
        raise ValueError("unsupported manifest schemaVersion")
    files = manifest.get("files")
    if not isinstance(files, list) or not files:
        raise ValueError("manifest must contain at least one file")
    if manifest.get("entrypoint") not in {item.get("path") for item in files}:
        raise ValueError("manifest entrypoint is not present in files")
    if manifest.get("totalSize") != sum(item.get("size", -1) for item in files):
        raise ValueError("manifest totalSize does not match file sizes")
    for item in files:
        path_value = item.get("path")
        if not isinstance(path_value, str) or Path(path_value).is_absolute() or ".." in Path(path_value).parts:
            raise ValueError(f"unsafe manifest path: {path_value!r}")
        if not isinstance(item.get("size"), int) or item["size"] < 0:
            raise ValueError(f"invalid size for {path_value}")
        digest = item.get("sha256")
        if not isinstance(digest, str) or len(digest) != 64:
            raise ValueError(f"invalid sha256 for {path_value}")
    return manifest


def manifest_digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while chunk := handle.read(8 * 1024 * 1024):
            digest.update(chunk)
    return digest.hexdigest()


def available_bytes(path: Path) -> int:
    return shutil.disk_usage(path).free


def validate_capacity(destination: Path, required_bytes: int) -> None:
    destination.mkdir(parents=True, exist_ok=True)
    free = available_bytes(destination)
    if free < required_bytes:
        raise RuntimeError(
            f"destination has {free} free bytes, but the model requires {required_bytes} bytes"
        )


def validate_file(destination: Path, item: dict, verify_checksum: bool) -> bool:
    path = destination / item["path"]
    if not path.is_file() or path.stat().st_size != item["size"]:
        return False
    return not verify_checksum or sha256(path) == item["sha256"]


def download_file(source: str, destination: Path, item: dict, aws: str) -> None:
    final_path = destination / item["path"]
    final_path.parent.mkdir(parents=True, exist_ok=True)
    partial_path = final_path.with_suffix(final_path.suffix + ".partial")
    partial_path.unlink(missing_ok=True)
    source_uri = f"{source.rstrip('/')}/{item['path']}"
    log(f"downloading {source_uri}")
    subprocess.run(
        [aws, "s3", "cp", "--only-show-errors", source_uri, str(partial_path)],
        check=True,
    )
    if partial_path.stat().st_size != item["size"]:
        partial_path.unlink(missing_ok=True)
        raise RuntimeError(f"downloaded size mismatch for {item['path']}")
    actual_digest = sha256(partial_path)
    if actual_digest != item["sha256"]:
        partial_path.unlink(missing_ok=True)
        raise RuntimeError(f"downloaded checksum mismatch for {item['path']}")
    os.replace(partial_path, final_path)
    log(f"verified {item['path']}")


def download(manifest: dict, manifest_path: Path, source: str, destination: Path, parallel: int, aws: str) -> None:
    validate_capacity(destination, manifest["totalSize"])
    pending = [item for item in manifest["files"] if not validate_file(destination, item, False)]
    if pending:
        with ThreadPoolExecutor(max_workers=parallel) as executor:
            futures = [executor.submit(download_file, source, destination, item, aws) for item in pending]
            for future in as_completed(futures):
                future.result()
    else:
        log("all model shards already have the expected sizes")

    log("checking all model shard checksums")
    invalid = [item["path"] for item in manifest["files"] if not validate_file(destination, item, True)]
    if invalid:
        raise RuntimeError(f"model validation failed: {', '.join(invalid)}")

    marker = destination / ".kimi-model-ready"
    marker.write_text(manifest_digest(manifest_path) + "\n", encoding="utf-8")
    log(f"model ready marker written to {marker}")


def validate_ready(manifest: dict, manifest_path: Path, destination: Path) -> None:
    marker = destination / ".kimi-model-ready"
    if not marker.is_file() or marker.read_text(encoding="utf-8").strip() != manifest_digest(manifest_path):
        raise RuntimeError("model is not ready for this manifest")
    missing = [item["path"] for item in manifest["files"] if not validate_file(destination, item, False)]
    if missing:
        raise RuntimeError(f"model files changed after validation: {', '.join(missing)}")


def render_command(template: list[str], model: Path, host: str, port: int) -> list[str]:
    values = {"model": str(model), "host": host, "port": str(port)}
    return [part.format(**values) for part in template]


def load_server_config(path: Path) -> list[str]:
    with path.open("r", encoding="utf-8") as handle:
        config = json.load(handle)
    command = config.get("command")
    if not isinstance(command, list) or not command or not all(isinstance(part, str) for part in command):
        raise ValueError("server config command must be a non-empty string array")
    return command


def main() -> int:
    parser = argparse.ArgumentParser(description="Download and start Kimi K2.5 from an S3 model mirror")
    parser.add_argument("action", choices=("download", "validate", "start", "download-and-start"))
    parser.add_argument("--manifest", type=Path, required=True)
    parser.add_argument("--destination", type=Path, required=True)
    parser.add_argument("--source", help="S3 prefix containing the manifest paths")
    parser.add_argument("--parallel", type=int)
    parser.add_argument("--aws", default="aws")
    parser.add_argument("--server-config", type=Path)
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=8000)
    args = parser.parse_args()

    manifest = load_manifest(args.manifest)

    if args.action in ("download", "download-and-start"):
        if not args.source:
            parser.error("--source is required for downloading")
        if args.parallel is None or args.parallel < 1:
            parser.error("--parallel must be provided and positive when downloading")
        download(manifest, args.manifest, args.source, args.destination, args.parallel, args.aws)

    if args.action == "validate":
        validate_ready(manifest, args.manifest, args.destination)
        log("model readiness validation passed")

    if args.action in ("start", "download-and-start"):
        if not args.server_config:
            parser.error("--server-config is required for starting")
        validate_ready(manifest, args.manifest, args.destination)
        model = args.destination / manifest["entrypoint"]
        command = render_command(load_server_config(args.server_config), model, args.host, args.port)
        log("starting: " + " ".join(command))
        os.execvp(command[0], command)

    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as error:
        log(f"ERROR: {error}")
        raise SystemExit(1)
