# Test database - separate from dev to avoid data loss
DATABASE_URL=postgresql://postgres:kiwi@localhost:5432/mythweavers_test

# Copy other settings from .env as needed
SESSION_SECRET=test-session-secret-do-not-use-in-production

# Standing consent for `prisma migrate reset --force` against the test DB.
# The test runner invokes this on every run to give each suite a clean slate;
# the URL above is hardcoded to the dedicated `mythweavers_test` database, so
# this can never touch dev/prod data. Pre-approving here so Claude Code (and
# anyone else running the suite) doesn't get the destructive-action prompt.
PRISMA_USER_CONSENT_FOR_DANGEROUS_AI_ACTION=standing consent for mythweavers_test reset
