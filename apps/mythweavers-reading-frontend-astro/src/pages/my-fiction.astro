---
import '../styles/global.css'
import { MyFictionPage } from '../components/pages/MyFictionPage'
import { chronicleTheme, starlightTheme } from '@mythweavers/ui/theme'
import {
  authApi,
  myFictionApi,
  type MyFictionStory,
  type Pagination,
  type User,
} from '../lib/api'

const themeCookie = Astro.cookies.get('writer-ui-theme')?.value
const initialTheme = themeCookie === 'chronicle' ? 'chronicle' : 'starlight'
const themeClass = initialTheme === 'chronicle' ? chronicleTheme : starlightTheme

let user: User | null = null
const cookieHeader = Astro.request.headers.get('cookie') || ''
try {
  const session = await authApi.getSession(cookieHeader)
  if (session.authenticated && session.user) user = session.user
} catch {
  // Not authenticated
}

const url = new URL(Astro.request.url)
const page = parseInt(url.searchParams.get('page') || '1', 10)
const pageSize = 12

let stories: MyFictionStory[] = []
let pagination: Pagination = { page: 1, pageSize, total: 0, totalPages: 1 }
if (user) {
  try {
    const result = await myFictionApi.list({ page, pageSize, cookie: cookieHeader })
    stories = result.stories
    pagination = result.pagination
  } catch (error) {
    console.error('Error fetching my fiction:', error)
  }
}

const buildPageUrl = (newPage: number) => {
  const newUrl = new URL(url)
  newUrl.searchParams.set('page', newPage.toString())
  return newUrl.pathname + newUrl.search
}
---

<html lang="en" class={themeClass}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>My Fiction - MythWeavers</title>
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <MyFictionPage
      client:load
      initialTheme={initialTheme}
      user={user}
      stories={stories}
      pagination={pagination}
      buildPageUrl={buildPageUrl}
    />
  </body>
</html>
