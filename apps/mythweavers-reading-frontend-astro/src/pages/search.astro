---
import '../styles/global.css'
import { SearchPage } from '../components/pages/SearchPage'
import { chronicleTheme, starlightTheme } from '@mythweavers/ui/theme'
import { storiesApi, authApi, type User } from '../lib/api'

const themeCookie = Astro.cookies.get('writer-ui-theme')?.value
const initialTheme = themeCookie === 'chronicle' ? 'chronicle' : 'starlight'
const themeClass = initialTheme === 'chronicle' ? chronicleTheme : starlightTheme

let user: User | null = null
try {
  const cookieHeader = Astro.request.headers.get('cookie') || ''
  const session = await authApi.getSession(cookieHeader)
  if (session.authenticated && session.user) user = session.user
} catch {
  // Not authenticated
}

const url = new URL(Astro.request.url)
const query = url.searchParams.get('q') || ''
const statusParam = (url.searchParams.get('status') || '') as
  | ''
  | 'ONGOING'
  | 'COMPLETED'
  | 'HIATUS'
const typeParam = (url.searchParams.get('type') || '') as '' | 'ORIGINAL' | 'FANFICTION'
const page = parseInt(url.searchParams.get('page') || '1', 10)
const pageSize = 20

let stories: any[] = []
let pagination = { page: 1, pageSize, total: 0, totalPages: 1 }
// Only call the backend when there's actually a search to make.
if (query || statusParam || typeParam) {
  try {
    const result = await storiesApi.list({
      page,
      pageSize,
      sortBy: 'recent',
      search: query || undefined,
      status: statusParam || undefined,
      type: typeParam || undefined,
    })
    stories = result.stories
    pagination = result.pagination
  } catch (error) {
    console.error('Error searching stories:', error)
  }
}

const buildPageUrl = (newPage: number) => {
  const newUrl = new URL(url)
  newUrl.searchParams.set('page', newPage.toString())
  return newUrl.pathname + newUrl.search
}
---

<html lang="en" class={themeClass}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Search - MythWeavers</title>
    <meta name="description" content="Search for stories on MythWeavers" />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <SearchPage
      client:load
      initialTheme={initialTheme}
      user={user}
      stories={stories}
      pagination={pagination}
      query={query}
      status={statusParam}
      type={typeParam}
      buildPageUrl={buildPageUrl}
    />
  </body>
</html>
